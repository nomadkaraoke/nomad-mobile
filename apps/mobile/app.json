{
  "expo": {
    "name": "Nomad Karaoke",
    "slug": "nomad-karaoke",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nomadkaraoke",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.nomadkaraoke.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "youtube",
          "vnd.youtube"
        ],
        "CFBundleDisplayName": "Karaoke",
        "NSAppleMusicUsageDescription": "Nomad Karaoke reads your Apple Music library and recent plays to pick karaoke songs you'll love singing."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#230a89",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nomadkaraoke.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#230a89",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save your karaoke videos to your Photos.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "expo-video",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to scan the host's QR code and join tonight's karaoke night.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
